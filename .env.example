# ==========================================
# AI Medical Intelligence Platform (MedTool)
# Environment Configuration Template
# ==========================================

# Server Configuration
# HOST: IP address to bind server (0.0.0.0 is required for Docker / Render)
HOST=0.0.0.0
# PORT: Port to listen on (Render dynamically assigns PORT at runtime, defaulting to 10000 on Render and 8000 locally)
PORT=8000
# LOG_LEVEL: Application logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Frontend & CORS Configuration
# Comma-separated list of allowed origins (e.g., http://localhost:5173,https://your-service.onrender.com)
# When the frontend is served statically by FastAPI, requests are same-origin.
FRONTEND_URL=http://localhost:5173

# Database Configuration
# SQLite (default for local development and container persistent disks):
DATABASE_URL=sqlite:///./backend/database/predictions.db
# PostgreSQL (for Render managed PostgreSQL databases):
# Note: Render provides postgres:// connection URLs which the backend automatically normalizes to postgresql://
# DATABASE_URL=postgresql://username:password@hostname.oregon-postgres.render.com/dbname

# Machine Learning Configuration
# Minimum confidence threshold (0.0 to 1.0) below which predictions are flagged as low confidence
CONFIDENCE_THRESHOLD=0.70

# Gemini LLM API Configuration
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
# If left blank, the application automatically falls back to the deterministic local radiology report generator.
GEMINI_API_KEY=
