# Database Configuration
# SQLite default: sqlite:///./predictions.db
# PostgreSQL example: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./predictions.db

# LLM Configuration
# Set your Gemini API key from Google AI Studio.
# If left blank, the application will fallback to the deterministic local report generator.
GEMINI_API_KEY=

# ML Configuration
# Configurable confidence threshold (0.0 to 1.0). Predictions below this will be flagged.
CONFIDENCE_THRESHOLD=0.70

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173
